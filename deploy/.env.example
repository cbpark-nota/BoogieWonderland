# ── Database ──
POSTGRES_USER=momentum
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=momentum
DB_PORT=5432

# ── Backend (APP_ prefix → Pydantic Settings) ──
APP_DATABASE_URL=postgresql+asyncpg://momentum:changeme@db:5432/momentum
APP_DATABASE_URL_SYNC=postgresql://momentum:changeme@db:5432/momentum
APP_SCHEDULER_ENABLED=true
APP_CORS_ORIGINS=["http://localhost","http://localhost:80"]
APP_FCM_CREDENTIALS_PATH=

# ── Frontend Build Args ──
API_URL=http://localhost:8000
DEPLOY_MODE=fullstack
BASE_HREF=/
FRONTEND_PORT=80
BACKEND_PORT=8000

# ── Collector ──
COLLECT_DATA_DIR=/data/daily
TZ=Asia/Seoul

# ── AWS (배포 시에만) ──
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=ap-northeast-2
# DATABASE_URL=postgresql+asyncpg://user:pass@rds-host:5432/momentum
# DATABASE_URL_SYNC=postgresql://user:pass@rds-host:5432/momentum
# FRONTEND_URL=https://app.example.com
